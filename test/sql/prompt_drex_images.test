# name: test/sql/prompt_drex_images.test
# description: prompt_drex sends BLOB and LIST<BLOB> inputs as Drex images, in order, as Image 1, Image 2 and so on
# group: [sql]

# The red and blue PNGs are generated by test/mock/pngs.py and served by the mock. For a choice between red and blue,
# the mock answers with the colour of the image the instructions name
include test/mock/requests.test_template

statement ok
FROM drex_reset('images');

statement ok
CREATE SECRET drex (TYPE nace, API_KEY 'nace_sk_mockKeyForDrexContractTests_000000000000000',
    BASE_URL '{DREX_MOCK_URL}/ns/images/ok');

statement ok
CREATE TABLE png AS SELECT
    (SELECT content FROM read_blob('{DREX_MOCK_URL}/__fixtures/red.png')) AS red,
    (SELECT content FROM read_blob('{DREX_MOCK_URL}/__fixtures/blue.png')) AS blue;

query II
SELECT octet_length(red) > 0, red[1:8] = '\x89PNG\x0D\x0A\x1A\x0A'::BLOB FROM png;
----
true	true

# --- one image -------------------------------------------------------------------------------------------------------

# A single BLOB is Image 1
query T
SELECT prompt_drex(red, 'What colour is Image 1?', choice := ['red', 'blue'], model := 'drex-max').choice FROM png;
----
red

# A list of one
query T
SELECT prompt_drex([blue], 'What colour is Image 1?', choice := ['red', 'blue'], model := 'drex-max').choice FROM png;
----
blue

# Drex Max v1.1 reads images too
query T
SELECT prompt_drex([red], 'What colour is Image 1?', choice := ['red', 'blue'], model := 'drex-max-v1.1').choice
FROM png;
----
red

# A retired id served by drex-max (alias_for in GET /v1/models) reads images too
query T
SELECT prompt_drex([red], 'What colour is Image 1?', choice := ['red', 'blue'], model := 'drex-v1.0').choice FROM png;
----
red

query TTIT
SELECT model, served_model, image_count, image_colours FROM drex_requests('images') WHERE endpoint = '/v1/systemone'
ORDER BY seq;
----
drex-max	drex-max	1	[red]
drex-max	drex-max	1	[blue]
drex-max-v1.1	drex-max-v1.1	1	[red]
drex-v1.0	drex-max	1	[red]

# --- two images, and the same two reversed: the order is kept ---------------------------------------------------------

statement ok
FROM drex_reset('images');

query TT
SELECT prompt_drex([red, blue], 'What colour is Image 2?', choice := ['red', 'blue'], model := 'drex-max').choice,
       prompt_drex([blue, red], 'What colour is Image 2?', choice := ['red', 'blue'], model := 'drex-max').choice
FROM png;
----
blue	red

query TT
SELECT prompt_drex([red, blue], 'What colour is Image 1?', choice := ['red', 'blue'], model := 'drex-max').choice,
       prompt_drex([blue, red], 'What colour is Image 1?', choice := ['red', 'blue'], model := 'drex-max').choice
FROM png;
----
red	blue

query IT
SELECT image_count, image_colours FROM drex_requests('images') WHERE endpoint = '/v1/systemone' ORDER BY image_colours;
----
2	[blue, red]
2	[blue, red]
2	[red, blue]
2	[red, blue]

# Images travel in the top-level images array only, never inside state or questions (each PNG is about 1 KB as
# base64), and every request succeeded
query II
SELECT bool_and(status = 200),
       bool_and(strlen(coalesce(state, '')) < 500 AND strlen(questions::VARCHAR) < 500)
FROM drex_requests('images') WHERE endpoint = '/v1/systemone';
----
true	true

# --- NULL images send nothing ----------------------------------------------------------------------------------------

statement ok
FROM drex_reset('images');

query T
SELECT prompt_drex(NULL::BLOB, 'What colour is Image 1?', choice := ['red', 'blue'], model := 'drex-max');
----
NULL

query T
SELECT prompt_drex(NULL::BLOB[], 'What colour is Image 1?', choice := ['red', 'blue'], model := 'drex-max');
----
NULL

query I
SELECT count(*) FROM drex_requests('images') WHERE endpoint = '/v1/systemone';
----
0

# --- what the client checks before sending ---------------------------------------------------------------------------

statement ok
FROM drex_reset('images');

# Drex takes any base64 as an image, so the client checks for PNG, JPEG or WebP magic bytes. A row with an image that
# is none of them is never sent and returns NULL (fix0_row_refusals.test covers the warning)
query T
SELECT prompt_drex(n::VARCHAR::BLOB, 'What colour is Image 1?', choice := ['red', 'blue'], model := 'drex-max')
FROM range(3) t(n);
----
NULL
NULL
NULL

query T
SELECT prompt_drex([red, 'GIF89a'::BLOB], 'What colour is Image 1?', choice := ['red', 'blue'], model := 'drex-max')
FROM png;
----
NULL

query I
SELECT count(*) FROM drex_requests('images') WHERE endpoint = '/v1/systemone';
----
0

# A row whose body would pass Drex's 4 MiB limit returns NULL and logs why; the other rows are answered
statement ok
CALL enable_logging(level = 'warning', storage = 'memory');

query IT
SELECT n, prompt_drex(image, 'What colour is Image 1?', choice := ['red', 'blue'], model := 'drex-max').choice
FROM (SELECT 1, red FROM png UNION ALL SELECT 2, red || repeat('a', 3200000)::BLOB FROM png) t(n, image)
ORDER BY n;
----
1	red
2	NULL

query I
SELECT count(*) FROM drex_requests('images') WHERE endpoint = '/v1/systemone';
----
1

query T
SELECT log_level FROM duckdb_logs
WHERE message LIKE 'prompt_drex: a row returned NULL: the request body is % bytes, over Drex''s limit of 4194304%';
----
WARNING
