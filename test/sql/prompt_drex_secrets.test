# name: test/sql/prompt_drex_secrets.test
# description: requests use the current nace secret's key and base URL
# group: [sql]

# The env provider is covered by prompt_drex_secret_env.test, which needs NACE_API_KEY and NACE_BASE_URL set
include test/mock/requests.test_template

statement ok
FROM drex_reset('secrets');

statement error
SELECT prompt_drex('text', 'Is it?');
----
No nace secret found

statement error
SELECT drex_decide('"text"', '{"a": {"type": "noul", "instructions": "Is it?"}}');
----
No nace secret found

statement ok
CREATE SECRET drex (TYPE nace, API_KEY 'nace_sk_mockKeyForDrexContractTests_000000000000000',
    BASE_URL '{DREX_MOCK_URL}/ns/secrets/ok/');

query R
SELECT prompt_drex('text', 'Is it?');
----
0.75

# Replacing the secret takes effect at once: no client keeps the old key
statement ok
CREATE OR REPLACE SECRET drex (TYPE nace, API_KEY 'nace_sk_mockKeyForDrexContractTests_111111111111111',
    BASE_URL '{DREX_MOCK_URL}/ns/secrets/ok');

query R
SELECT prompt_drex('text', 'Is it?');
----
0.75

# The trailing slash in the first BASE_URL was dropped, so both reached the mock's /v1/systemone
query T
SELECT authorization_header FROM drex_requests('secrets') WHERE endpoint = '/v1/systemone' ORDER BY seq;
----
Bearer nace_sk_mockKeyForDrexContractTests_000000000000000
Bearer nace_sk_mockKeyForDrexContractTests_111111111111111

statement ok
DROP SECRET drex;

statement error
SELECT prompt_drex('text', 'Is it?');
----
No nace secret found

query I
SELECT count(*) FROM drex_requests('secrets') WHERE endpoint = '/v1/systemone';
----
2
