# name: test/sql/t1_retry_schedule.test
# description: many rows waiting to retry at once are each answered on their retry
# group: [sql]

# The retry queue grows and shrinks under workers waiting on it; the debug build's AddressSanitizer checks that no
# wait reads its freed storage

include test/mock/requests.test_template

statement ok
FROM drex_reset('t1_retry');

# No rate limit, so the retries of every row are due together
statement ok
SET drex_max_rpm = 0;

statement ok
CREATE OR REPLACE SECRET drex (TYPE nace, API_KEY 'nace_sk_mockKeyForDrexContractTests_000000000000000',
    BASE_URL '{DREX_MOCK_URL}/ns/t1_retry/429-once');

# Each of the 32 rows is refused once with retry-after-ms 1000, so their retries pile up while workers wait on the
# earliest one
query IR
SELECT count(*), round(min(prompt_drex('Ticket ' || i, 'Is the customer asking for a refund?')), 4)
FROM range(32) t(i);
----
32	0.9868

query TII
SELECT list(status ORDER BY seq), count(*), count(DISTINCT body_sha256)
FROM drex_requests('t1_retry') WHERE endpoint = '/v1/systemone' GROUP BY body_sha256 ORDER BY ALL LIMIT 1;
----
[429, 200]	2	1

query I
SELECT count(DISTINCT body_sha256) FROM drex_requests('t1_retry') WHERE endpoint = '/v1/systemone' AND status = 200;
----
32
