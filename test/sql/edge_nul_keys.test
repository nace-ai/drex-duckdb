# name: test/sql/edge_nul_keys.test
# description: a label or question id holding a NUL byte reads its own answer, not that of the key cut at the NUL
# group: [sql]

include test/mock/requests.test_template

statement ok
FROM drex_reset('edge_nul_keys');

statement ok
CREATE SECRET drex (TYPE nace, API_KEY 'nace_sk_mockKeyForDrexContractTests_000000000000000',
    BASE_URL '{DREX_MOCK_URL}/ns/edge_nul_keys/ok');

# The mock answers the documented refund question 0.9868 and any other noul 0.75
query T
SELECT to_json(r)::VARCHAR FROM (SELECT prompt_drex('Please refund me.', questions := '{
    "a\u0000b": {"type": "noul", "instructions": "Refund?"},
    "a": {"type": "noul", "instructions": "Is the customer asking for a refund?"}}'::JSON) AS r);
----
{"a\u0000b":0.75,"a":0.9868}

# The mock picks the first label, with weights 2 and 1; the probabilities come back sorted by label
query TT
SELECT r.choice = 'a' || chr(0) || 'b', [p.probability FOR p IN r.probabilities]
FROM (SELECT prompt_drex('text', 'Which?', choice := ['a' || chr(0) || 'b', 'a']) AS r);
----
true	[0.3333, 0.6667]

# Both keys were sent whole
query T
SELECT questions->>'$[0].id' = 'a' || chr(0) || 'b' FROM drex_requests('edge_nul_keys')
WHERE endpoint = '/v1/systemone' ORDER BY seq LIMIT 1;
----
true
