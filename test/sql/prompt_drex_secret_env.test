# name: test/sql/prompt_drex_secret_env.test
# description: a nace secret from the env provider reads NACE_API_KEY and NACE_BASE_URL
# group: [sql]

# CI's mock job sets NACE_API_KEY to a well-formed test key and NACE_BASE_URL to {DREX_MOCK_URL}/ns/secret_env/ok
require-env NACE_API_KEY

require-env NACE_BASE_URL

include test/mock/requests.test_template

statement ok
FROM drex_reset('secret_env');

statement ok
CREATE SECRET drex (TYPE nace, PROVIDER env);

query R
SELECT prompt_drex('text', 'Is it?');
----
0.75

query II
SELECT count(*), bool_and(authorization_header = 'Bearer {NACE_API_KEY}') FROM drex_requests('secret_env')
WHERE endpoint = '/v1/systemone';
----
1	true
